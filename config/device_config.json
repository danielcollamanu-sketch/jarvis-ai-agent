{
  "device": {
    "name": "Primary Device",
    "id": "device_primary_001",
    "os": "linux",
    "type": "desktop"
  },
  "apps_and_functions": {
    "audio": {
      "enabled": true,
      "functions": ["play_music", "pause_music", "stop_audio", "set_volume", "list_playlists"]
    },
    "system": {
      "enabled": true,
      "functions": ["get_system_stats", "list_processes", "get_network_info", "get_storage_info", "check_system_health"]
    },
    "files": {
      "enabled": true,
      "functions": ["list_directory", "read_file", "write_file", "delete_file", "search_files"],
      "restricted_paths": ["/etc", "/sys", "/root", "/boot"]
    },
    "network": {
      "enabled": true,
      "functions": ["ping_host", "check_internet", "get_device_ip", "discover_local_devices"]
    }
  },
  "permissions": {
    "system_control": "limited",
    "file_access": "restricted",
    "network_access": "allowed",
    "process_execution": "sandboxed"
  },
  "security": {
    "enable_sandboxing": true,
    "enable_audit_logging": true,
    "audit_log_file": "config/audit.log",
    "require_user_confirmation": {"system_changes": true, "file_deletion": true, "process_execution": false}
  },
  "research": {
    "enable_autonomous_research": true,
    "respect_robots_txt": true,
    "research_topics": ["technology", "science", "artificial_intelligence", "programming"]
  },
  "network_mesh": {
    "enabled": true,
    "discovery_enabled": true,
    "port": 9999,
    "peer_sync_interval": 300
  }
}
