{
  "security_policies": {
    "sandboxing": {
      "enabled": true,
      "level": "strict",
      "max_processes": 5,
      "max_memory_mb": 512,
      "timeout_seconds": 30
    },
    "code_modification": {
      "enabled": true,
      "require_safety_check": true,
      "require_backup_before_modify": true,
      "auto_rollback_on_failure": true,
      "max_modification_percentage": 0.1
    },
    "file_operations": {
      "allowed_read_paths": [
        "./config",
        "./data",
        "./documents"
      ],
      "allowed_write_paths": [
        "./config",
        "./data",
        "./logs"
      ],
      "restricted_extensions": [
        ".exe",
        ".sh",
        ".bat",
        ".cmd"
      ]
    },
    "network": {
      "allowed_protocols": [
        "http",
        "https",
        "ws",
        "wss"
      ],
      "blocked_domains": [],
      "rate_limiting": {
        "requests_per_minute": 60,
        "requests_per_hour": 1000
      }
    },
    "autonomous_actions": {
      "min_autonomy_level_for_action": 0.4,
      "require_whitelist": true,
      "whitelisted_actions": [
        "research",
        "learn",
        "self_improvement",
        "background_monitoring"
      ]
    }
  },
  "audit_settings": {
    "log_all_actions": true,
    "log_device_access": true,
    "log_code_modifications": true,
    "log_autonomous_decisions": true,
    "retention_days": 30
  }
}
